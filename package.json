{
  "name": "school-district-monitoring",
  "version": "1.0.0",
  "private": true,
  "description": "A full-stack School District Monitoring System built with Express, PostgreSQL, Bootstrap 4, and vanilla JavaScript.",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "db:init": "node database/init.js",
    "db:migrate": "node scripts/migrate.js",
    "db:hash": "node scripts/hash-password.js",
    "test": "node --test --test-concurrency=1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.7.5",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "pg": "^8.13.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
