# Copy this file to .env and replace every placeholder before starting the app.
NODE_ENV=development
PORT=3000

# PostgreSQL connection string for the application role.
DATABASE_URL=postgresql://school_monitor:replace-with-a-strong-password@localhost:5432/school_district_monitoring

# Set to true when your managed PostgreSQL provider requires TLS.
DATABASE_SSL=false
PG_POOL_MAX=10

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_NAME=sdms.sid

# Password reset links expire after this many minutes.
RESET_TOKEN_MINUTES=60

# Set to 1 only when the app runs behind a trusted reverse proxy over HTTPS.
TRUST_PROXY=0

# Leave blank for same-origin only. If set, use a single trusted origin.
CORS_ORIGIN=

APP_NAME=School District Monitoring System
APP_VERSION=1.0.0

# Public URL of the deployed site, used in emailed password reset links.
# Leave blank to derive it from the incoming request.
PUBLIC_BASE_URL=

# Password reset email delivery through the Mailgun HTTP API. Render blocks
# outbound SMTP ports, so the API key is used instead of SMTP credentials.
# MAILGUN_DOMAIN is the sending domain (or sandbox domain) from Mailgun,
# MAILGUN_REGION is "us" or "eu", and MAILGUN_FROM defaults to
# "<APP_NAME> <no-reply@MAILGUN_DOMAIN>".
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=
MAILGUN_REGION=us

# Security firewall. Leave SECURITY_BOOTSTRAP_TOKEN blank except while creating
# the first SuperAdmin, then remove it. Generate a 16+ character value with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

SECURITY_BOOTSTRAP_TOKEN=47b5fd93d89f78439f9c06f58b2f9193a60ec9ed
TOTP_secret=I5LKGJGICcijrCfZBuqDzBWp3qSrBEZCqBUfQVz4CWGHWF91iaEw

# Private directory for re-encoded school logo files. It is never served as a
# static directory; point it at persistent storage in production.
SCHOOL_LOGO_DIR=storage/school-logos

# Keep backups and forensic evidence outside client/ and on persistent storage.

SECURITY_BACKUP_DIR=backups/security
SECURITY_HEALTH_INTERVAL_MS=30000
SECURITY_CODE_SCAN_INTERVAL_MS=300000
SECURITY_RETENTION_DAYS=30

# Displayed in the console only; email delivery is not implemented.
SECURITY_ALERT_EMAIL=
